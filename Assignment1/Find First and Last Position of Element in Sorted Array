class Solution {
    public int[] searchRange(int[] arr, int x) 
    {
        int ls[]=new int[2];
        int ans1=-1,ans2=-1;
        int start=0,end=arr.length-1;
        while(start<=end)
        {
            int mid=start+(end-start)/2;
            if(arr[mid]==x)
            {
                ans1=mid;
                end=mid-1;
            }
            else if(arr[mid]<x)
            {
                start=mid+1;
            }
            else
            {
                end=mid-1;
            }
        }
        
        start=0;
        end=arr.length-1;
        while(start<=end)
        {
            int mid=start+(end-start)/2;
            if(arr[mid]==x)
            {
                ans2=mid;
                start=mid+1;
            }
            else if(arr[mid]<x)
            {
                start=mid+1;
            }
            else
            {
                end=mid-1;
            }
        }
        ls[0]=ans1;
        ls[1]=ans2;
        return ls;    
    }
}
