class Solution {
    public boolean isPerfectSquare(int num) 
    {
        int start=1,end=num;
        while(start<=end)
        {
            int mid=start+(end-start)/2;
            long pro = (long) mid * mid;

            if(pro==num)
            {
                return true;
            }
            else if(pro>num)
            {
                end=mid-1;
            }
            else
            {
                start=mid+1;
            }
        } 
        return false;   
    }
}
