class Solution {
    public int maxSubArray(int[] arr) 
    {
        int pre=0;
        int ans=Integer.MIN_VALUE;
        for(int i=0;i<arr.length;i++)
        {
            pre+=arr[i];
            ans=Math.max(pre,ans);
            if(pre<0)
            {
                pre=0;
            }
            
        }
        return ans;    
    }
}
